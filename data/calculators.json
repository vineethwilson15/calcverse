    ],
    "outputs": [
      { "id": "futureValue", "label": "Future Value", "format": "currency" },
      { "id": "totalInvested", "label": "Total Invested", "format": "currency" },
      { "id": "wealthGained", "label": "Wealth Gained", "format": "currency" }
    ],
    "hasChart": true,
    "chartType": "pie",
    "chartConfig": { "labels": ["Invested", "Returns"], "dataKeys": ["totalInvested", "wealthGained"] },
    "explanation": "<h3>How SIP Returns are Calculated</h3><p>SIP returns use the future value of an annuity formula:</p><p class=\"formula\">FV = P × [((1 + r)<sup>n</sup> − 1) / r] × (1 + r)</p><p>Where <strong>P</strong> is the monthly investment, <strong>r</strong> is the monthly rate of return, and <strong>n</strong> is the total number of months.</p>",
    "relatedCalculators": ["emi", "compound-interest", "loan"],
    "priority": 0.9
  },
  {
    "id": "compound-interest",
    "title": "Compound Interest Calculator",
    "description": "Calculate compound interest on your savings or investments. Compare different compounding frequencies and see growth over time.",
    "category": "financial",
    "keywords": ["compound interest", "interest calculator", "savings calculator"],
    "icon": "financial",
    "inputs": [
      { "id": "principal", "label": "Principal Amount", "type": "currency", "default": 100000, "min": 1, "step": 1000 },
      { "id": "rate", "label": "Annual Interest Rate (%)", "type": "percent", "default": 7, "min": 0.1, "max": 100, "step": 0.1 },
      { "id": "time", "label": "Time Period (years)", "type": "number", "default": 5, "min": 1, "max": 50, "step": 1 },
      { "id": "frequency", "label": "Compounding Frequency", "type": "number", "default": 12, "min": 1, "max": 365, "step": 1 }
    ],
    "outputs": [
      { "id": "finalAmount", "label": "Final Amount", "format": "currency" },
      { "id": "interestEarned", "label": "Interest Earned", "format": "currency" }
    ],
    "hasChart": true,
    "chartType": "pie",
    "chartConfig": { "labels": ["Principal", "Interest"], "dataKeys": ["principal", "interestEarned"] },
    "explanation": "<h3>Compound Interest Formula</h3><p class=\"formula\">A = P × (1 + r/n)<sup>n×t</sup></p><p>Where <strong>P</strong> is the principal, <strong>r</strong> is the annual interest rate, <strong>n</strong> is the compounding frequency per year, and <strong>t</strong> is the time in years.</p>",
    "relatedCalculators": ["emi", "sip", "loan"],
    "priority": 0.8
  },
