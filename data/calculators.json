    "id": "emi",
    "title": "EMI Calculator",
    "description": "Calculate your Equated Monthly Installment for home loans, car loans, and personal loans. See total interest payable and payment breakdown.",
    "category": "financial",
    "keywords": ["emi calculator", "loan emi", "monthly installment calculator"],
    "icon": "financial",
    "inputs": [
      { "id": "principal", "label": "Loan Amount", "type": "currency", "default": 1000000, "min": 1, "step": 1000 },
      { "id": "rate", "label": "Interest Rate (% per year)", "type": "percent", "default": 8.5, "min": 0.1, "max": 50, "step": 0.1 },
      { "id": "tenure", "label": "Loan Tenure (months)", "type": "number", "default": 60, "min": 1, "max": 360, "step": 1 }
    ],
    "outputs": [
      { "id": "emi", "label": "Monthly EMI", "format": "currency" },
      { "id": "totalInterest", "label": "Total Interest", "format": "currency" },
      { "id": "totalPayment", "label": "Total Payment", "format": "currency" }
    ],
    "hasChart": true,
    "chartType": "pie",
    "chartConfig": { "labels": ["Principal", "Interest"], "dataKeys": ["principal", "totalInterest"] },
    "explanation": "<h3>How EMI is Calculated</h3><p>EMI (Equated Monthly Installment) is calculated using the formula:</p><p class=\"formula\">EMI = P × r × (1 + r)<sup>n</sup> / ((1 + r)<sup>n</sup> − 1)</p><p>Where <strong>P</strong> is the loan amount, <strong>r</strong> is the monthly interest rate (annual rate / 12 / 100), and <strong>n</strong> is the tenure in months.</p>",
    "relatedCalculators": ["sip", "compound-interest", "loan"],
    "priority": 0.9
  },
